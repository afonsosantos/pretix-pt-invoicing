msgid "Fact.pt"
msgstr "Fact.pt"

msgid ""
"Issues AT-certified invoice-receipts via Fact.pt asynchronously after "
"payment confirmation, with a tracking and retry panel."
msgstr ""
"Emite faturas-recibo AT-certificadas via Fact.pt de forma assíncrona após a "
"confirmação de pagamento, com painel de acompanhamento e retry."

