msgstr "A sua nota de crédito da encomenda {code}"

#, python-brace-format
msgid ""
"Hello,\n"
"\n"
"a credit note for order {code} is attached to this e-mail.\n"
"\n"
"Best regards,\n"
"Your {event} team"
msgstr ""
"Olá,\n"
"\n"
"segue em anexo a nota de crédito da encomenda {code}.\n"
"\n"
"Com os melhores cumprimentos,\n"
"A equipa do {event}"

