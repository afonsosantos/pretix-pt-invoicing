"Hello,\n"
"\n"
"your invoice for order {code} is attached to this e-mail.\n"
"\n"
"Best regards,\n"
"Your {event} team"
msgstr ""
"Olá,\n"
"\n"
"segue em anexo a sua fatura da encomenda {code}.\n"
"\n"
"Com os melhores cumprimentos,\n"
"A equipa do {event}"

#, python-brace-format
